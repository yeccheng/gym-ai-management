<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.gym</groupId>
        <artifactId>gym-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>gym-ai</artifactId>
    <packaging>jar</packaging>
    <name>gym-ai</name>
    <description>智能体层：ChatClient、RAG 混合检索、Function Calling、SSE、异步任务</description>

    <dependencies>
        <dependency>
            <groupId>com.gym</groupId>
            <artifactId>gym-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gym</groupId>
            <artifactId>gym-training</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gym</groupId>
            <artifactId>gym-ai-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- DeepSeek / 通义 / Ollama 全部走 OpenAI 兼容协议，
             切换只改 base-url 与 api-key，业务代码零改动 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <!--
          ES 8 兼做中文全文检索（BM25）与向量召回（kNN），一个组件两用。
          刻意不用 Spring AI 的 ElasticsearchVectorStore：它只封装了纯向量检索，
          而混合检索需要自己发 BM25 + kNN 两路查询再在应用层做 RRF 融合，
          用官方 VectorStore 反而要把它的封装拆开。直接用 ES Java Client 最可控。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-elasticsearch</artifactId>
        </dependency>
        <dependency>
            <groupId>co.elastic.clients</groupId>
            <artifactId>elasticsearch-java</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-rag</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-advisors-vector-store</artifactId>
        </dependency>
        <!-- 把业务工具暴露成 MCP Server，是本项目的差异化亮点 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
